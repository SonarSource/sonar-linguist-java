{
  "$id": "https://sonarsource.github.io/linguist-java/schemas/runtime-data-manifest-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "resource": {
      "additionalProperties": false,
      "properties": {
        "artifactFamily": {
          "enum": [
            "compiledRegex",
            "heuristics",
            "languageCatalog",
            "pathRules"
          ]
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "type": "string"
        },
        "sourcePath": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifactFamily",
        "path",
        "schemaVersion",
        "sha256",
        "source",
        "sourcePath"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "commit",
        "origin",
        "version"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resources": {
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "$ref": "#/$defs/source"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "resources",
    "schemaVersion",
    "sources"
  ],
  "title": "Linguist Java runtime data manifest v1",
  "type": "object"
}
